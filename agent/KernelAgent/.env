# Tell KernelAgent to use GPT-5
OPENAI_MODEL=gpt-5

# Your Azure key
#OPENAI_API_KEY=<your-azure-key>

# Point to Azure endpoint (OpenAI-compatible)
#OPENAI_BASE_URL=<your-azure-endpoint>

# Required for Azure APIs
#OPENAI_API_VERSION=2025-01-01-preview

NUM_KERNEL_SEEDS=4            # parallel workers per kernel
MAX_REFINEMENT_ROUNDS=10      # retry budget per worker
LOG_LEVEL=INFO                # logging level
